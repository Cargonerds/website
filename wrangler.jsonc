{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cargonerds-website",
  "compatibility_date": "2026-11-01",
  // Static-assets-only Worker: everything in ./public is served as-is.
  // /imprint -> imprint.html, /privacy -> privacy.html (clean URLs, same routes as the Lovable app)
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  }
}
